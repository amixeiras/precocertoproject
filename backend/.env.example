# Configurações do Banco de Dados
# Para usar PostgreSQL (Docker ou Nuvem), descomente a linha abaixo:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/precocerto

# Se DATABASE_URL não for definido, o backend usa o SQLite local (backend/data/precocerto.db) automaticamente.
PORT=3001
PORT_ALIAS=3000

